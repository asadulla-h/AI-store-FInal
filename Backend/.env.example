GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ecommerce-catalog

# Comma-separated allowed browser origins (no wildcard in production)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-store.com

REDIS_URL=redis://localhost:6379/0
# Use "memory" on Render if you have no Redis yet (sessions reset on redeploy)
SESSION_BACKEND=redis
SESSION_TTL_SECONDS=86400
MAX_HISTORY_TURNS=20

RATE_LIMIT=30/minute
STORE_NAME=Weave Wardrobe
GEMINI_MODEL=gemini-2.5-flash
ROUTER_MODEL=gemini-2.5-flash
PORT=8000
